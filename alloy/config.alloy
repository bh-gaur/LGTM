// 1. Receive OTLP data (gRPC and HTTP)
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [
      otelcol.processor.batch.default.input,
      otelcol.connector.spanmetrics.default.input,
    ]
  }
}

// 2. Spanmetrics Connector (derives RED metrics from trace spans)
otelcol.connector.spanmetrics "default" {
  namespace = "traces.spanmetrics"

  histogram {
    explicit {
      buckets = ["5ms", "10ms", "25ms", "50ms", "100ms", "250ms", "500ms", "1s", "2.5s", "5s", "10s"]
    }
  }

  dimension {
    name = "http.method"
  }
  dimension {
    name = "http.status_code"
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
  }
}

// 3. Batch processor to optimize data transmission
otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.otlphttp.mimir.input]
    logs    = [otelcol.exporter.loki.loki_out.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// 3. Exporters

// Metrics to Mimir (via native OTLP HTTP)
otelcol.exporter.otlphttp "mimir" {
  client {
    endpoint = env("MIMIR_ENDPOINT")
    tls { insecure = true }
  }
}

prometheus.remote_write "mimir" {
  endpoint {
    url = env("MIMIR_REMOTE_WRITE_URL")
    send_exemplars = true
  }
}

// Logs to Loki
otelcol.exporter.loki "loki_out" {
  forward_to = [loki.write.loki_endpoint.receiver]
}

loki.write "loki_endpoint" {
  endpoint {
    url = env("LOKI_PUSH_URL")
  }
}

// Traces to Tempo
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = env("TEMPO_ENDPOINT")
    tls { insecure = true }
  }
}

// 4. Scrape Alloy's internal metrics
prometheus.scrape "alloy" {
  targets = [{"__address__" = env("ALLOY_INTERNAL_METRICS_TARGET")}]
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// 5. Scrape Node.js application metrics (supports OpenMetrics exemplars)
prometheus.scrape "node_app" {
  targets = [{"__address__" = env("NODE_APP_SCRAPE_TARGET")}]
  forward_to = [prometheus.remote_write.mimir.receiver]
}
